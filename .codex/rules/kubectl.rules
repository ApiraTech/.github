# Codex permission rules. Tracked deliberately: an untracked allow-list is per-machine, so
# two operators get different agent behaviour from the same task.
# Read-only and hermetic only. Mutating and irreversible commands are deliberately absent --
# they fall through to a prompt, which is the decision point.
# Added 2026-08-31.
# Read-only inspection. Mutation falls through to a prompt.
prefix_rule(pattern=["kubectl", ["get", "describe", "logs", "explain", "api-resources", "api-versions", "version", "top", "cluster-info"]], decision="allow")
prefix_rule(pattern=["kubectl", "auth", "can-i"], decision="allow")
prefix_rule(pattern=["kubectl", "config", ["current-context", "get-contexts", "view"]], decision="allow")
